{
  "name": "dsh-session-leftover-purge",
  "version": "2.0.0",
  "description": "删除会话后清理 bili / cost-meter / dsh-context / archive-manager 的残留 / Purge session leftovers across DSH plugins",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "node --test",
    "prepack": "npm run build"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "license": "MIT",
  "author": "fenri",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "billion-context",
    "bili",
    "cost-meter",
    "dsh-context",
    "archive-manager",
    "session",
    "cleanup",
    "sqlite"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FenrirCait/dsh-session-leftover-purge.git"
  },
  "homepage": "https://github.com/FenrirCait/dsh-session-leftover-purge#readme",
  "bugs": {
    "url": "https://github.com/FenrirCait/dsh-session-leftover-purge/issues"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "README.en.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.1 <0.3.0-0"
    }
  },
  "engines": {
    "node": ">=22.13.0 <23.0.0 || >=23.4.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "^0.1.7-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.7-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/schemastery": ">=3.18.4 <4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-plugin-manager": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/schemastery": "^3.19.0",
    "@types/node": "^24.19.2",
    "typescript": "~5.9.3"
  }
}
